{
  "name": "qmk-keymap-lens",
  "displayName": "QMK Keymap Lens",
  "description": "Visual keymap editing for QMK keymap.c files",
  "publisher": "the-matt-moo",
  "version": "0.1.2",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/the-matt-moo/qmk-keymap-lens"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:qmkLens.doctor",
    "onCommand:qmkLens.openVisual",
    "onCommand:qmkLens.compile",
    "onCommand:qmkLens.flash",
    "onCommand:qmkLens.openToolbox",
    "onCustomEditor:qmkLens.keymap"
  ],
  "contributes": {
    "commands": [
      {
        "command": "qmkLens.doctor",
        "title": "QMK Lens: Doctor"
      },
      {
        "command": "qmkLens.openVisual",
        "title": "QMK Lens: Open Visual Editor"
      },
      {
        "command": "qmkLens.compile",
        "title": "QMK Lens: Compile Keymap",
        "icon": "$(gear)"
      },
      {
        "command": "qmkLens.flash",
        "title": "QMK Lens: Flash Keymap",
        "icon": "$(zap)"
      },
      {
        "command": "qmkLens.openToolbox",
        "title": "QMK Lens: Open in QMK Toolbox"
      }
    ],
    "customEditors": [
      {
        "viewType": "qmkLens.keymap",
        "displayName": "QMK Lens Visual Editor",
        "selector": [
          {
            "filenamePattern": "**/keymaps/*/keymap.c"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "qmkLens.openVisual",
          "when": "resourceFilename == keymap.c",
          "group": "navigation"
        },
        {
          "command": "qmkLens.compile",
          "when": "resourceFilename == keymap.c",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "QMK Keymap Lens",
      "properties": {
        "qmkLens.msysRoot": {
          "type": "string",
          "default": "C:/QMK_MSYS",
          "description": "QMK MSYS install root."
        },
        "qmkLens.qmkHome": {
          "type": "string",
          "default": "",
          "description": "qmk_firmware path. Empty = use `qmk config user.qmk_home`."
        },
        "qmkLens.toolboxPath": {
          "type": "string",
          "default": "C:/Program Files/QMK Toolbox/qmk_toolbox.exe",
          "description": "Path to QMK Toolbox."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/smoke.mjs",
    "compile-check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/compile-check.mjs",
    "package": "vsce package --no-dependencies",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hjson": "3.2.2",
    "tree-sitter-c": "0.24.1",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/hjson": "^2.4.6",
    "@types/node": "^24.19.1",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
